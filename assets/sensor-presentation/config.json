    "captureTab": "viewfinder",
    "disclosure": "chevron.right",
    "externalLink": "arrow.up.right",
    "fusionTab": "point.3.connected.trianglepath.dotted",
    "identityDocument": "creditcard",
    "identityFace": "faceid",
    "identityPassport": "book.closed",
    "identitySSN": "number",
    "identityTab": "person.text.rectangle",
    "knownLimit": "exclamationmark.triangle",
    "sensorsTab": "waveform.path.ecg",
    "settingsTab": "gearshape"
