  // The subscriber comparison inside a phone result.
  "subscriber": {
    "noResult": "Your text was received. A usable subscriber comparison was not returned.",
    "status": {
      "satisfied": "Required details agree",
      "notSatisfied": "Some details differ",
      "incomplete": "Comparison incomplete"
    },
    "requiredDetails": "Required details",
    "outsidePolicy": "Details outside the accepted grades",
    "incompleteDetails": "Details missing usable evidence",
    "result": "Result",
    "submitted": "Submitted",
    "comparedByCarrier": "Compared by the carrier source",
    "scope": "Comparison scope",
    "fieldsCovered": "Fields covered",
    "reason": "Reason",
    "wholeAddressTitle": "Whole address",
    "wholeAddressNotice": "This combined observation does not fill in missing individual address checks.",
    "coverageBasis": "Coverage basis",
    "recordSource": "Record source",
    "sourceObserved": "Source observed",
    // Why the comparison did not return a usable answer. Phone possession stays confirmed.
    "failure": {
      "busy": "Your text was received. The subscriber comparison could not start because another request was still finishing.",
      "consentRequired": "Your text was received. The subscriber comparison was not run because agreement to compare was not recorded.",
      "invalidRequest": "Your text was received. The subscriber comparison was not run because your checked ID did not supply the details it needs.",
      "contextChanged": "Your text was received. The subscriber comparison was not run because your checked ID changed during the check.",
      "storageUnavailable": "Your text was received. The subscriber comparison could not be saved or opened on this phone.",
      "notConfigured": "Your text was received. The subscriber comparison was not run because the comparison service is not set up for this app.",
      "unauthorized": "Your text was received. The subscriber comparison was not run because the comparison service did not accept this app’s credentials.",
      "forbidden": "Your text was received. The subscriber comparison was not run because the comparison service does not permit it for this app.",
      "profileChanged": "Your text was received. The subscriber comparison was not run because the comparison rules changed. You can start the phone check again.",
      "expiredRequest": "Your text was received. The subscriber comparison was not run because the request expired before it could be sent. You can start the phone check again.",
      "invalidEvidence": "Your text was received. The subscriber comparison was not run because the comparison service did not accept the phone check’s proof.",
      "rateLimited": "Your text was received. The subscriber comparison was not run because the comparison service asked this app to wait.",
      "capabilityUnavailable": "Your text was received. The subscriber comparison was not run because the comparison is not available for this number.",
      "outcomeUnknown": "Your text was received. The subscriber comparison may have run, but its answer was not received. Opening this result will not run it again.",
      "invalidResponse": "Your text was received. The subscriber comparison answered, but the answer could not be verified and was not accepted."
    },
    // Names for the values a subscriber comparison reports: fields, grades, scopes and sources.
    "label": {
      "givenName": "Given name",
      "familyName": "Family name",
      "birthDate": "Date of birth",
      "addressLines": "Street address",
      "addressLine1": "Address line 1",
      "addressLine2": "Address line 2",
      "city": "City",
      "region": "State or region",
      "postalCode": "Postal code",
      "country": "Country",
      "exactMatch": "Exact match",
      "highPartialMatch": "High partial match",
      "partialMatch": "Partial match",
      "lowPartialMatch": "Low partial match",
      "noMatch": "Does not match",
      "noData": "No data",
      "unsupported": "Unsupported",
      "unavailable": "Unavailable",
      "indeterminate": "Indeterminate",
      "notRequested": "Not requested",
      "individualAttribute": "Individual field",
      "combinedAddressLines": "Address lines together",
      "wholeAddress": "Whole address",
      "unqualified": "Not established",
      "notApplicable": "Not applicable",
      "reportedGrade": "The carrier source reported this grade",
      "unsupportedField": "Field unsupported",
      "unsupportedNetwork": "Network unsupported",
      "supplierUnavailable": "The carrier source was unavailable",
      "notAuthorized": "Not authorized",
      "omittedResult": "Result omitted",
      "unknownSupplierValue": "Unrecognized carrier source value",
      "unqualifiedSemantics": "Meaning not established",
      "invalidSupplierResponse": "Invalid carrier source response",
      "qualified": "Established",
      "unverified": "Not established",
      "operator": "Operator",
      "thirdParty": "Third party",
      "mixed": "Mixed",
      "unknown": "Unknown",
      "other": "Unrecognized value"
    }
  },

  // The Settings tab: the sensor board's settings, then this app's own saved data.
  "settings": {
    "identityData": "Saved identity data",
    // Shown under the saved identity data section when nothing has been saved yet.
    "reviewSaved": "Open a check to review or erase its saved results. Results stay on this phone until you erase them.",
    "developer": "Developer"
  },

  // The phone sensor board. Most of its words are SensorHost's, generated into
  // sensor-presentation/copy.json and read through copy() in SensorPresentation.ts; these are the
  // words this app adds around them.
  "sensors": {
    "opening": "Opening sensors…",
    // Re-enables collection after erase or a failed request.
    "resumeCollection": "Resume collection",
    // {title} is a sensor section's name, such as Motion.
    "about": "About {title}",
    "waitingForReading": "Waiting for a reading.",
    "state": {
      "paused": "Paused"
    },
    // The operating system's answer for one sensor permission.
    "permission": {
      "given": "Allowed",
      "refused": "Denied",
      "notRequested": "Not asked yet",
      "unavailable": "Unavailable",
      "always": "Always allow location"
    },
    // A measurement and its unit: {value} is already formatted for the device locale.
    "measurement": "{value} {unit}",
    // Unit symbols the sensor board prints after a value.
    "unit": {
      "hectopascals": "hPa",
      "inchesOfMercury": "inHg",
      "metres": "m",
      "feet": "ft",
      "metresPerSecond": "m/s",
      "milesPerHour": "mph",
      "celsius": "°C",
      "fahrenheit": "°F",
      "microtesla": "µT",
      "gravity": "g",
      "radiansPerSecond": "rad/s",
      "degrees": "°",
      "percent": "%"
    },
    // {value} is a number of seconds, already formatted.
    "seconds": "{value} s",
    // The same duration, as VoiceOver reads it.
    "secondsSpoken": "{value} seconds",
    // Joins the parts of a short value, as in a weather station's name and identifier.
    "joiner": " · ",
    // The words for a reason the native sensor board reported by code. SensorHost's own words are
    // used where it has them (collection, export, erase and weather-provider failures).
    "failureCode": {
      "saveFailed": "The signed reading could not be saved.",
      "tamperFailed": "The newest reading could not be altered.",
      "forgetFailed": "The kept readings could not be deleted.",
      "readFailed": "The kept readings could not be read.",
      "noFixMeetsContract": "No position iOS delivered met the fix terms.",
      "locationUnavailable": "Location is unavailable.",
      "noLocationFix": "Weather needs a position first. Get one fix, then try again."
    },
    "failure": {
      "open": "Sensors could not be opened.",
      "activity": "Sensors could not change activity state.",
      "closeTitle": "Sensors could not close",
      "closeBody": "Reopen the app before starting another sensor session.",
      "request": "The request stopped. Check permissions or try again.",
      "notConfigured": "Sensors are not configured in this app.",
      "session": "The sensor session could not be opened. Go back and try again.",
      "requestUnfinished": "The request could not finish. Open Identity, then return to Sensors to try again.",
      "close": "The sensor session could not close.",
      "refresh": "The sensor refresh stopped. Open Identity, then return to Sensors to try again.",
      "read": "The sensors could not be read. Trying again.",
      "settings": "iOS Settings could not be opened."
    },
    "export": {
      "prepare": "Prepare export",
      "share": "Share export",
      "shareFailed": "The export could not be shared.",
      "notLocal": "The export is not a local file.",
      "tamper": "Tamper with newest reading",
      "tamperTitle": "Tamper with reading",
      "tamperBody": "This deliberately changes the newest local evidence to test verification.",
      "forget": "Forget exported readings",
      "forgetTitle": "Forget readings",
      "forgetBody": "Remove this host’s retained export evidence."
    },
    // Full erase. The body must keep naming every kind of key the erase removes.
    "erase": {
      "action": "Erase local sensor data",
      "title": "Erase sensor data",
      "body": "Delete local sensor readings, continuity records, signing keys and biometric approval keys in this app. Identity documents stay on the phone. Collection will remain paused.",
    },
    "persisted": {
      // {count} is already formatted.
      "savedItems": "{count} saved items"
    },
    "window": {
      // {sensor} is the sensor's name. VoiceOver reads this as the slider's label.
      "label": "{sensor} reading time",
      "shared": "Shared motion capture"
    },
    "location": {
      // {count} fixes of at most {limit} are on the map.
      "fixesOnMap": "{count} of {limit}"
    },
    "weather": {
      "note": "Weather uses the phone’s position to request a report from the configured weather service.",
      "notConfigured": "Weather is not configured in this host.",
      "row": {
        "pressure": "Pressure",
        "temperature": "Temperature",
        "humidity": "Humidity",
        "station": "Station",
        "distance": "Distance",
        "stationHeight": "Station height",
        "quality": "Quality",
        "source": "Source",
        "reportedAt": "Reported at"
      }
    },
    // Apple documentation pages for a sensor section.
    "docs": {
      "openFailed": "The documentation could not be opened.",
      // {title} is a sensor section's name.
      "howWorkedOut": "How {title} is worked out",
      // One numbered step of an algorithm explanation.
      "step": "{number}. {text}"
    }
  },

  // Failure messages of the Jest test helpers in __tests__/support.ts. No screen shows them; the
  // boundary gate's host scan reads that helper as host source, so its words live here too.
  "testSupport": {
    "unexpectedNativeOperation": "Unexpected native operation in this test",
    "missingFixture": "Required test fixture value is absent",
    // {key} is the name of a React prop.
    "missingHandler": "Required event handler is absent: {key}"
  },

  // The simulator-only developer checks screen. Developers read these; the holder never does.
  "developer": {
    "title": "SDK package integration",
    "environment": "React Native 0.87.1 · iOS · installed npm artifact",
    "run": "Run simulator checks",
    "preview": "Native preview component (camera stopped)",
    "status": {
      "ready": "Ready",
      "running": "Running",
      // {code} is a closed error code, or developer.noCode.
      "createFailed": "Create failed: {code}",
      "passed": "{count, plural, one {# check passed} other {# checks passed}}",
      // {message} is the name of the check that failed.
      "failed": "FAILED: {message}",
      "releaseFailed": "Session release failed"
    },
    "noCode": "no code returned",
    // Stands in for {message} in developer.status.failed when the failure carried no message.
    "nativeCommandFailed": "Native command failed",
    // {code} is the error code a check expected.
    "expected": "Expected {code}",
    "missingCameraFailure": "Missing camera failure event",
    "check": {
      "independentSessions": "Independent native sessions",
      "emptyResults": "Isolated completed-result list starts empty",
      "resultErasure": "Completed-result custody erasure",
      "mrzParser": "Packaged MRZ parser",
      "partialRead": "Partial read remains partial",
      "cameraFailsClosed": "Simulator fails closed without TrueDepth",
      "releaseIsolation": "Release preserves the other session"
    },
    // Messages passed to the NFC sheet by a check that expects the read to be refused. {group}
    // and {progress} are filled in by the system sheet.
    "nfc": {
      "presenting": "Hold your phone against your passport.",
      "authenticating": "Connecting — {progress}%",
      "reading": "Reading {group} — {progress}%",
      "activeAuthentication": "Checking the chip.",
      "transportFinishing": "Read complete.",
      "failure": "The passport could not be read. Try again."
    }
  }
}
