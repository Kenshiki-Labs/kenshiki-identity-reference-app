      "selfieUnavailable": "The captured selfie is no longer available. Take another selfie.",
      "comparisonUnavailable": "We could not find a usable face comparison in these images. Take another selfie in even light.",
      "noFaceDetected": "A face could not be found in one of the images. Take another selfie in even light.",
      "faceImageUnreadable": "One of the face images could not be opened. Take another selfie.",
      "faceEmbeddingFailed": "The face model could not process these images. Your passport results are kept.",
