// English (US) text for the React Native reference app. Every word the app shows lives in this
// file. `generate-ui-resources.py` compiles it into `locales/strings.generated.ts`, and screens
// read it through `t(key, values)` from `locales/i18n.ts`. A key the catalog does not hold is a
// TypeScript compile error.
//
// Messages use ICU MessageFormat:
//   {name}                                   a value filled in by the app
//   {count, plural, one {…} other {…}}       a count; # inside a branch is the count
//   {name, select, a {…} other {…}}          one branch per value
// A straight apostrophe before { } or # quotes it; typographic ’ is ordinary text.
//
// Keys are stable identifiers: dotted paths built from this file's nesting. Rename a key only
// together with every screen that uses it. To add a language, copy this file to
// locales/<language>.jsonc with the same keys and placeholders, and add the language's plural
// rule to the generator.
{
  "prerequisite": {
    "title": "Complete the earlier checks",
    "document": "Open License or state ID and choose Check record. A successful result unlocks Phone.",
    "phone": "Complete the phone check before checking your Social Security number.",
    "service": "This check is not connected yet.",
    "back": "Back to Identity"
  },
  "firstRun": {
    "location": {
      "title": "Allow location",
      "body": "Choose Always so location is available for continuity checks. Keep Precise Location on. iOS may ask in two stages."
    },
    "motion": {
      "title": "Allow Motion & Fitness",
      "body": "Use the phone’s barometer to compare air pressure with local weather."
    },
    "bluetooth": {
      "title": "Allow Bluetooth",
      "body": "Read Bluetooth status and your connected audio route."
    },
    "step": "Step {number} of {total}",
    "request": "Continue",
    "next": "Next",
    "open": "Open Kenshiki SDK",
    "notNow": "Not now",
    "settings": "Open Settings",
    "allowed": "Access is enabled.",
    "locationReady": "Always and Precise Location are enabled.",
    "unavailable": "This permission is not available on this device. You can continue.",
    "denied": "Access is off or restricted. You can review it in Settings or continue without it.",
    "whileUsing": "iOS currently allows access only while using the app. Always access is still needed.",
    "preciseBody": "iOS is sharing an approximate position. Enable Precise Location in Settings.",
    "camera": "We’ll ask for camera access when you start a scan or face capture.",
    "failure": "This step could not finish. Try again or choose Not now."
  },
  "fusionUI": {
    "refreshAir": "Refresh air check",
    "retryAir": "Retry air check",
    "passCountValue": "Readings so far: {count}",
    "evaluate": "Evaluate this reading",
    "evaluating": "Working…",
    "forget": "Forget continuity history",
    "forgetTitle": "Forget continuity history?",
    "forgetMessage": "Removes the saved continuity history. Signing keys and other evidence stay on this phone.",
    "forgetNote": "History is kept on this phone. Forgetting it does not replace keys or erase sensor evidence.",
    "receiptLimit": "Local verification checks this reading against the public key inside its receipt. It does not independently prove device identity, server acceptance, or that every sensor value is true.",
    "wiring": "This reference app exposes identity capture and phone checks alongside sensor evidence. These separate results are not automatically a single verified identity claim. Server acceptance and anchoring are separate.",
    "cancelled": "The check was cancelled. No comparison was completed.",
    "notAvailable": "Not available",
    "noEnvelope": "Collect a reading in Sensors before evaluating continuity.",
    "invalidReceipt": "The reading’s receipt did not verify. It cannot establish continuity.",
    "olderEnvelope": "This reading predates the saved continuity history.",
    "readFailed": "Continuity history could not be read. Existing history has not been replaced.",
    "saveFailed": "Continuity history could not be saved. This result is not durable progress.",
    "eraseFailed": "Continuity history could not be removed.",
    "metric": "{value} {unit}",
    "fraction": "{count} / {total}",
    "scenario": "{days} days · {readings} readings",
    "scenarioDetail": "At least {lower}; confidence {confidence}",
    "gap": "{hours} hours",
    "illustrative": "Illustrative projections, not recorded history. Quality and breadth are held at this evaluation’s values; the timeline assumes about two readings per day.",
    "missingScenario": "A continuity evaluation is required. Missing inputs are not replaced with perfect quality.",
    "working": "Native SDK calculations from this result; the screen does not recompute the score.",
    "readingWhen": "Sensors, Fusion and Settings share one sensor session. Each continuity evaluation uses the current signed Sensors reading once. Returning to a tab does not earn another pass.",
    "keyLoss": "If the custody key is missing, existing history cannot be continued. This screen does not silently replace the key.",
    "pressureUnits": "Pressure values in the working are kPa; heights are metres and temperatures are kelvin or Celsius as labelled.",
    "locationAt": "Location measured at",
    "pressureField": "Source pressure field",
    "observationURL": "Observation source",
    "maximumAge": "Maximum observation age",
    "maximumDistance": "Maximum station distance",
    "temperatureQuality": "Temperature quality",
    "source": "Source",
    "nws": "National Weather Service",
    "stage": "Failure stage",
    "httpStatus": "HTTP status",
    "failingField": "Failing field",
    "decodingPath": "Decoding path",
    "receivedAt": "Received at",
    "envelopeID": "Evaluated reading",
    "collectedAt": "Reading collected at",
    "firstPassAt": "History began",
    "previousPassAt": "Previous pass",
    "lastPassAt": "Latest pass",
    "stateWeight": "Host state weight",
    "mathTitle": "The working",
    "airFormula": "H = (R/g) × mean column temperature; expected pressure = sea-level pressure × exp(−altitude/H).",
    "allowanceFormula": "Allowance combines height, temperature and area uncertainty in quadrature, bounded by the SDK floor and ceiling.",
    "residualFormula": "Residual = |measured − expected|; consistent when residual ≤ allowance.",
    "continuityFormula": "The SDK combines history maturity with live evidence quality. Breadth and eligible coverage remain separate inputs.",
    "diagram": "Residual {residual} kPa; allowance {allowance} kPa. The diagram is clamped; the exact numbers below are authoritative.",
    "glossaryKeyTerm": "Device signing key",
    "glossaryKeyBody": "The private signing key stays in native custody. Its public key verifies signatures. Secure hardware status and local verification are reported separately; an embedded public key alone is not independent device attestation."
  },
  "fusionMath": {
  "temperature": "Temperature used",
  "meanColumn": "Mean air-column temperature",
  "scaleHeight": "Scale height",
  "heightAllowance": "Height uncertainty",
  "temperatureAllowance": "Temperature uncertainty term",
  "uncertaintyBudget": "Unclamped uncertainty budget",
  "gasConstantOverGravity": "Gas constant / gravity",
  "halfLapse": "Half lapse rate",
  "temperatureUncertainty": "Temperature uncertainty constant",
  "areaUncertainty": "Area pressure uncertainty",
  "altitudeSigmas": "Altitude uncertainty multiplier",
  "allowanceFloor": "Allowance floor",
  "allowanceCeiling": "Allowance ceiling",
  "stationInputPressure": "Station input pressure",
  "stationPressure": "Pressure at station elevation",
  "calculatedSeaLevelPressure": "Calculated sea-level pressure",
  "coverage": "Eligible coverage",
  "breadth": "Evidence breadth",
  "recency": "Recency",
  "maturity": "History maturity",
  "coherence": "Coherence",
  "signalAuthenticity": "Live evidence quality",
  "posteriorMean": "Estimate",
  "lowerCredibleBound": "Lower bound",
  "confidenceWidth": "Confidence width",
  "evidenceWeight": "Evidence weight",
  "effectiveCheckIns": "Effective readings",
  "halfMaturityDays": "Half-maturity days",
  "daysSteepness": "Days steepness",
  "checkInTarget": "Readings target",
  "priorEvidence": "Prior evidence",
  "lowerBoundZ": "Lower-bound z",
  "networkChangeCoherence": "Network change coherence",
  "contradictionCoherenceWeight": "Contradiction coherence weight"
} ,
  "@metadata": {
    // The BCP 47 tag dates are formatted with while this catalog is in use.
    "formatLocale": "en-US"
  },

  // The brand. An app that signs this host under its own brand replaces these words, the brand
  // values in ui/tokens.jsonc and the files in brand/.
  "brand": {
    // The shared page header and generated native launch screen use this same wordmark.
    "wordmark": "Kenshiki SDK",
    // The name under the app's icon on the Home Screen. create-host.py writes it into the
    // generated app's Info.plist as CFBundleDisplayName.
    "appName": "Kenshiki SDK"
  },

  // Words several screens share, with the same meaning everywhere.
  "common": {
    // Button that leaves a check and returns to the hub screen named "Identity".
    "backToIdentity": "Back to Identity",
    "backToResults": "Back to results",
    "done": "Done",
    "tryAgain": "Try again",
    "tryCameraAgain": "Try camera again",
    // Opens this app's page in the iOS Settings app.
    "openSettings": "Open Settings",
    "pleaseWait": "Please wait…",
    "startOver": "Start over",
    "saveResult": "Save result",
    // Title of a card shown when a check's answer arrived but could not be saved on the phone.
    "saveYourResult": "Save your result",
    "runNewCheck": "Run a new check",
    "eraseChecks": "Erase checks",
    "checkNeedsAttention": "Check needs attention",
    "checkPaused": "Check paused",
    // Small uppercase line above a result kept from an earlier check.
    "previousCheck": "PREVIOUS CHECK",
    "letsTryAgain": "Let’s try that again",
    // A row value: the service did not send this detail.
    "notReturned": "Not returned",
    // A row value: the service sent an empty list.
    "noneReported": "None reported",
    // A field the app has no name for.
    "otherDetail": "Other detail",
    "yes": "Yes",
    "no": "No",
    // Joins the items of a short list on one line, as in "City, Postal code".
    "listSeparator": ", ",
    "openingSavedResults": "Opening saved results…",
    "socialSecurityNumber": "Social Security number",
    "reportedOutcome": "Reported outcome",
    // A row label: when a comparison was made. The value is a date and time.
    "compared": "Compared",
    // Shown under a button whose action failed before it could report its own error.
    "actionFailed": "This action could not finish. Try again.",
    // A controller could not start or a previous session could not close safely.
    "sessionRecovery": "Close and reopen the app before starting another check. Your saved results have not been erased.",
    // Dismisses a confirmation without acting.
    "cancel": "Cancel",
    // Returns from a detail page to its parent.
    "back": "Back",
    // What VoiceOver reads for a list row with a status line: {label} is the row's title, {status}
    // the line under it.
    "labelAndStatus": "{label}, {status}",
    // Marks the chosen row of a list of choices.
    "checkmark": "✓"
  },

  // Dates and times.
  "format": {
    "timeNotRecorded": "Time not recorded",
    "dateNotRecorded": "Date not recorded",
    // A date printed on a passport's machine-readable lines, which carry only two year digits,
    // so the century is not known: for example 15 Jun ’85.
    "mrzDate": "{day} {month, select, m01 {Jan} m02 {Feb} m03 {Mar} m04 {Apr} m05 {May} m06 {Jun} m07 {Jul} m08 {Aug} m09 {Sep} m10 {Oct} m11 {Nov} m12 {Dec} other {}} ’{year}"
  },

  // The hub screen, which lists every identity check.
  "hub": {
    "title": "Identity",
    "resultsTitle": "Your results",
    "licenseTitle": "Your license or state ID",
    "liveServicesUnavailable": "Identity services could not be set up. Document, phone and Social Security number checks are unavailable in this build.",
    "configurationIssue": "Saved checks are unavailable because this app’s local holder record could not be read. New checks are not saved.",
    "license": {
      "title": "License or state ID",
      "continueBack": "Front saved · Continue with the back",
      "start": "Scan your license or state ID, or open a saved capture",
      "captured": "Capture saved · Open to check the record",
      "recordMatched": "Record matched · View capture and check",
      "checkNeedsAttention": "Record check needs attention"
    },
    "passport": {
      "title": "Passport",
      // {givenNames} and {surname} are read from the passport's chip.
      "viewResults": "{givenNames} {surname} · View results",
      "openSaved": "Open saved passport results",
      "start": "Scan and read your passport",
      "notSetUp": "Passport chip checking is not set up in this app. Your other identity checks remain available."
    },
    "face": {
      "title": "Face match",
      "viewResults": "Comparison complete · View results",
      "chooseSaved": "Choose a saved passport to view its face check",
      "notSetUp": "Face comparison is not set up in this app.",
      "start": "Compare a selfie with your passport photo",
      "needsPassport": "Read a passport to add its photo first"
    },
    "ssn": {
      "needsAttention": "Check needs attention · Open",
      // {summary} is the SSN result summary, for example "Reported as issued".
      "viewResult": "{summary} · View result",
      "start": "Compare your number with your checked ID and phone"
    },
    // The status line of a check this app cannot run; the section's footer says why.
    "notAvailable": "Not available",
    // Section headers of the Identity list.
    "section": {
      "checks": "Checks",
      "saved": "Saved results"
    },
    "phone": {
      "title": "Phone",
      "resume": "Check in progress · Resume",
      "stopped": "Check stopped · Subscriber details differ from your ID",
      "viewResult": "Result available · View receipt and comparison",
      "start": "Send a text and compare subscriber details with your checked ID"
    },
    "action": {
      "openSavedPassportChecks": "Open saved passport checks",
      "savedNotice": "Saved passport and face results stay on this phone until you erase them.",
      "eraseAll": "Erase all passport and face results",
      "deleteLicenseScans": "Delete saved card captures",
      // Opens the simulator-only developer checks screen.
      "developerChecks": "Developer checks",
      "clearResults": "Clear results"
    },
    // Shown in the saved-results sheet when a check's native session could not be released.
    "closeFailed": {
      // The previous holder's checks, released when the holder changes.
      "previous": "The previous checks could not be closed. Reopen this screen.",
      "check": "A check could not be closed. Reopen this screen."
    },
    "restore": {
      "title": "Saved results could not be opened",
      // {reason} is one of the hub.restoreError messages.
      "body": "{reason} Nothing has been erased.",
      "reopen": "Reopen saved results",
      "erase": "Erase saved passport and face results"
    },
    "restoreError": {
      "sessionUnavailable": "The saved results closed before they finished opening. Try reopening them.",
      "busy": "Another check is still finishing. Wait a moment, then reopen your saved results.",
      "other": "Your saved results could not be opened. Try reopening them."
    },
    "clear": {
      "failedTitle": "Deletion could not finish",
      "licenseTitle": "Delete all saved card captures?",
      "passportTitle": "Erase all passport and face results?",
      "licenseBody": "This deletes every saved license and state-ID capture from this app, including its photos and read details.",
      "passportBody": "This deletes all saved passport and face results from this app, including their photos.",
      "deleteLicenseScans": "Delete all card captures",
      "keep": "Keep results"
    },
    "clearError": {
      "busy": "Another check is still finishing. Wait a moment, then try again. Nothing has been deleted yet.",
      "sessionUnavailable": "This screen closed before deletion finished. Try again. Nothing has been deleted yet.",
      "resultsNotConfigured": "Saved results are not set up in this app, so there is nothing to delete here.",
      "resultIntegrityFailure": "This phone could not open its secure storage to delete them. Try again. Your saved results are unchanged.",
      "documentCustodyFailed": "This phone could not open its secure storage to delete them. Try again. Your saved scans are unchanged.",
      "storageUnavailable": "This phone could not open its secure storage to delete them. Try again. Nothing has been deleted yet.",
      "other": "The saved results could not be deleted. They have not been removed from this screen. Try again."
    }
  },

  // The passport and face comparison flow.
  "passport": {
    "title": {
      "loading": "Opening saved checks",
      "saved": "Saved passport checks",
      "intro": "Your passport",
      "scanning": "Scan your passport",
      "review": "Check the printed details",
      "reading": "Reading your passport",
      "results": "Your results",
      "comparing": "Comparing your photos",
      "selfie": "Take a selfie"
    },
    "action": {
      "retakeSelfie": "Retake selfie",
      "compareSelfie": "Compare with a selfie",
      "readChipAgain": "Read chip again"
    },
    "camera": {
      "scanHint": "Put the two lines at the bottom of the photo page inside the clear band.",
      "ready": "Printed details found. Capturing…",
      "keepInView": "Keep both lines in view.",
      "holdSteady": "Hold the passport steady.",
      "captureDetails": "Capture details",
      "captureSelfie": "Capture selfie"
    },
    "saved": {
      "choose": "Choose a saved passport check.",
      // {moment} is the date and time the check was saved.
      "savedAt": "Saved {moment}",
      "open": "Open saved results",
      "scanAnother": "Scan another passport"
    },
    "intro": {
      "body": "Scan the photo page, then hold your phone against the passport to read its chip. You can review the passport and compare its photo with a selfie.",
      "privacy": "Your captures stay on this phone. Starting allows camera capture; reading the chip begins when you choose to continue.",
      "start": "Start passport scan"
    },
    "review": {
      "body": "Check these details against your passport.",
      "next": "Next, hold the top of your phone against the passport and keep it still.",
      "read": "Read passport chip",
      "scanAgain": "Scan again"
    },
    "comparing": "Your selfie was captured. Comparing it with the passport photo…",
    "scanDifferent": "Scan a different passport",
    "sheet": {
      "restartTitle": "Start a new passport check?",
      "keepCheck": "Keep this check",
      "backToDetails": "Back to passport details",
      "saveCompleted": "Save completed result",
      "keepResults": "Keep passport results"
    },
    // Rows of passport details. Values come from the passport.
    "field": {
      "name": "Name",
      "documentNumber": "Passport number",
      "birthDate": "Date of birth",
      "expiryDate": "Expiry date",
      "surname": "Surname",
      "givenNames": "Given names",
      "nationality": "Nationality",
      "issuedBy": "Issued by",
      "placeOfBirth": "Place of birth",
      "issuingAuthority": "Issuing authority",
      "dateOfIssue": "Date of issue",
      "sex": "Sex recorded on the chip",
      "personalNumber": "Personal number"
    },
    "result": {
      "title": "Passport",
      "chipChecksRecorded": "Chip checks recorded",
      // {moment} is when the chip checks were first recorded.
      "chipChecksRecordedAt": "{moment}. Opening saved results does not repeat them.",
      "readAt": "Read at",
      "bacFallback": "The chip was opened using BAC after PACE did not complete. The signing and data integrity checks are reported separately.",
      "paceParametersUnavailable": "The chip was opened using BAC; PACE parameters were unavailable. The signing and data integrity checks are reported separately.",
      "failedNotice": "A failed chip check means this passport read should not be relied on. Read the chip again, or use another document.",
      "chipPhoto": "Passport chip photo",
      "passportPhoto": "Passport photo",
      "comparedSelfie": "Compared selfie",
      "yourSelfie": "Your selfie",
      "noPortrait": "No usable chip photo was available. Read the chip again to try for a photo.",
      // Heading above rows comparing the printed lines with the chip. Shown in capitals.
      "correspondenceHeading": "PRINTED DETAILS AND CHIP",
      "matches": "Matches",
      "differs": "Different — review this field",
      "notCompared": "Not compared",
      "noCorrespondence": "Printed details were not compared with the chip."
    },
    // Names of the chip security checks.
    "protocol": {
      "countrySigningChain": "Issuer signing chain (revocation and expiry are not checked)",
      "documentSignature": "Chip data signature",
      "dataGroupHashes": "Data integrity",
      "activeAuthentication": "Active authentication",
      "chipAuthentication": "Chip authentication",
      "pace": "PACE connection",
      "basicAccessControl": "BAC connection"
    },
    "protocolFailed": {
      "countrySigningChain": "Issuer signing chain failed",
      "documentSignature": "Chip data signature failed",
      "dataGroupHashes": "Data integrity check failed",
