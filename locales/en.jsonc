  // The license record check panel on driver's license results.
  "documentCheck": {
    "title": "License record check",
    "notConfigured": "Record checking is not configured for this app. Your saved photos and barcode details remain available.",
    "busy": "Opening or checking the saved record…",
    "outcome": {
      "recordMatched": "Issuing record matched",
      "recordNotMatched": "Issuing record did not match",
      "pending": "Check still pending",
      "unavailable": "No answer available",
      "needsCorrection": "Review the requested details",
      "inconclusive": "No conclusive record comparison"
    },
    "state": {
      "unanswered": "A request was sent. No answer is saved yet.",
      "readerUnavailable": "The document reader could not complete this check.",
      "unreadable": "The saved image could not be read.",
      "unavailable": "The check could not finish. Reopen its saved status.",
      "notStarted": "No record check has been made."
    },
    // {moment} is the date and time of the check.
