      "comment": "Footer under the two fractions.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two fractions, kept apart on purpose. A sensor this phone lacks, or a permission you refused, makes a lane unavailable: it lowers how much could be said, never how much you are believed."
          }
        }
      }
    },
    "continuity.firstPass": {
      "comment": "Verdict on the very first pass.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to compare with yet"
          }
        }
      }
    },
    "continuity.firstPass.note": {
      "comment": "Footer on the first run, when no earlier pass exists.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing has been saved from an earlier pass yet, so there is nothing to compare against. The next reading will have one."
          }
        }
      }
    },
    "continuity.forget.header": {
      "comment": "Section title above the button that deletes the saved fingerprint.",
