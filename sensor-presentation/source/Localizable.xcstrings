          "stringUnit": {
            "state": "translated",
            "value": "iOS can hand back a position it already had, so it can be older than the button press."
          }
        }
      }
    },
    "location.row.age": {
      "comment": "Row label: how long ago iOS measured the position, ticking every second.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Age"
          }
        }
      }
    },
    "location.row.altitude": {
      "comment": "Row label: height above sea level, in metres.",
      "extractionState": "manual",
