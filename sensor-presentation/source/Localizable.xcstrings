    "fusion.proofs.device": {
      "comment": "The first of three proofs.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which phone — a key inside this phone's Secure Enclave signs every reading, and a chain makes an edited history stop lining up."
          }
        }
      }
    },
    "fusion.proofs.header": {
      "comment": "Title of the card at the top of the Fusion tab explaining what proves what.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three proofs, not one"
          }
        }
      }
    },
    "fusion.proofs.note": {
      "comment": "Footer under the three proofs, saying what continuity is not.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuity is the middle one: it will say \"same phone\" about a stolen phone and be right, because it was never a claim about who is holding it. That claim is the third proof — and one key signs both, which is what lets the two be read as a single record."
          }
        }
      }
    },
    "fusion.proofs.person": {
      "comment": "The third of three proofs.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who the person is — Face ID, the passport chip, the licence, the face match. Signed by the same key, into the same chain, as everything else."
          }
        }
      }
    },
    "fusion.proofs.presence": {
      "comment": "The second of three proofs.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where it was — a position, how long it stayed, and the phone's own air pressure agreeing with the weather. Cheap to read once, expensive to fake for months."
          }
        }
      }
    },
    "fusion.readingReady": {
      "comment": "Glance value for continuity when a sensor pass exists but the screen has not been opened.",
