    "continuity.anchor.header": {
      "comment": "Section title above the key, the signature and the chain.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What makes it the same phone"
          }
        }
      }
    },
    "continuity.anchor.note": {
      "comment": "Footer under the anchor section.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sensors never prove sameness. This does: a key that exists in one phone's silicon and cannot be copied out, a signature over every reading, and a chain in which each reading commits to the ones before it."
          }
        }
      }
    },
    "continuity.answer.header": {
      "comment": "Section title above the continuity verdict.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer"
          }
        }
      }
