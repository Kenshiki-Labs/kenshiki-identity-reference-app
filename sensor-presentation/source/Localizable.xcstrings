    "docs.motion.algorithm.1": {
      "comment": "On the Motion page, under how the answer is worked out: one step of it, in plain words.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each is reduced to its length: the square root of the sum of the three squares. That is a size with no direction, which is what makes it comparable between one moment and the next."
          }
        }
      }
    },
    "docs.motion.algorithm.2": {
