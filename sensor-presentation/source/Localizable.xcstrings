        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnetic field"
          }
        }
      }
    },
    "magnetometer.row.calibration": {
      "comment": "Row label: how well the magnetometer is calibrated.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibration"
          }
        }
      }
    },
    "magnetometer.row.field": {
      "comment": "Row label: magnetic field strength, in microtesla.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strength"
          }
        }
      }
    },
    "meaning.audioRoute": {
      "comment": "One-line meaning under the Audio route section.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where sound would come out, and how often that has changed. Plugging in headphones or getting into a car shows up here."
          }
        }
      }
    },
    "meaning.barometer": {
      "comment": "One-line meaning under the Barometer section.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Air pressure around the phone. It falls as you climb, so it can tell a floor from the one above it."
          }
        }
      }
    },
    "meaning.bluetooth": {
      "comment": "One-line meaning under the Bluetooth section.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether the Bluetooth radio is on and what kind of audio device it is connected to. No device names are read."
          }
        }
      }
    },
    "meaning.callActivity": {
      "comment": "One-line meaning under the Calls section.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether a call is in progress, and how often that has changed. No numbers, names or audio."
          }
        }
      }
    },
    "meaning.connectivity": {
      "comment": "One-line meaning under the Network section.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How this phone reaches the network right now, and whether it recognises the Wi-Fi."
          }
        }
      }
    },
    "meaning.deviceSurface": {
      "comment": "One-line meaning under the Device section.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What this device says it is: the system it runs, its kind, and the app asking."
          }
        }
      }
    },
    "meaning.location": {
      "comment": "One-line meaning under the Location section.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where the phone is, how precise that is, and how old the reading is. Nothing here is saved."
          }
        }
      }
    },
    "meaning.magnetometer": {
      "comment": "One-line meaning under the Magnetic field section.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The strength of the magnetic field around the phone. Steel, speakers and cars all bend it."
          }
        }
      }
    },
    "meaning.motion": {
      "comment": "One-line meaning under the Motion section.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How the phone is being moved and held, worked out from its accelerometer and gyroscope."
          }
        }
      }
    },
    "meaning.status": {
      "comment": "One-line meaning under the Status section.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How often the app asks every sensor for a fresh reading."
          }
        }
      }
    },
    "meaning.telephony": {
      "comment": "One-line meaning under the Mobile network section.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the mobile radio reports: the network generation, whether a SIM matches, and data service changes."
          }
        }
      }
    },
    "meaning.thermalAndPower": {
      "comment": "One-line meaning under the Battery and heat section.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How charged and how warm the phone is, which is also how hard it has been working."
          }
        }
      }
    },
    "meaning.weather": {
      "comment": "One-line meaning under the Weather section.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the air is doing around you, from the nearest weather station. Pressure here is what the barometer can be checked against."
          }
        }
      }
    },
    "motion.footer": {
      "comment": "Footer under the Motion section, telling the reader what to try.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lying still, movement and rotation stay near zero. Pick the phone up or turn it and they change."
          }
        }
      }
    },
    "motion.header": {
      "comment": "Section title on the Sensors tab: how the phone moves and turns.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion"
          }
        }
      }
    },
    "motion.row.gravity": {
      "comment": "Row label: gravity as the phone feels it, in g. About 1 when still.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravity"
          }
        }
      }
    },
    "motion.row.rotationRate": {
      "comment": "Row label: how fast the phone is turning, in radians per second.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotation"
          }
        }
      }
    },
    "motion.row.userAcceleration": {
      "comment": "Row label: how hard the phone is being moved, in g.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Movement"
          }
        }
      }
    },
    "overTime.break.is": {
      "comment": "What a break is.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A break is the phone changing underneath the key: a different device kind, or a SIM inserted or removed. The key survives, the chain keeps extending, and the earned history restarts from zero."
          }
        }
      }
    },
    "overTime.break.narrow": {
      "comment": "Why the break test is narrow.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The test is deliberately narrow. A new network, a new city, a refused permission, an OS update: all normal life, none of them a break. A test that fired on those would be noise, and nobody would trust the times it did fire."
          }
        }
      }
    },
    "overTime.gap.header": {
      "comment": "Section title: what stopping does.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What a gap costs"
          }
        }
      }
    },
    "overTime.gap.how": {
      "comment": "How a gap affects the numbers.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reading stays fully fresh for a day, then decays to nothing over the next two. Earned history stays where it is: it is the live half that fades, so an unused phone keeps its past and stops being able to say anything about its present."
          }
        }
      }
    },
    "overTime.gap.meaning": {
      "comment": "What the gap numbers mean together.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The live half falls to nothing after three days, but the earned half stays where it is, and the estimate is the geometric mean of the two — so it drops a long way and never reaches zero while a history exists. One reading restores it."
          }
        }
      }
    },
    "overTime.keyLoss.differs": {
      "comment": "How key loss differs from a break.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the heavier of the two. A break restarts the count under the same identity; losing the key ends that identity. The old chain stays verifiable forever, but nothing new can ever be added to it, and the new key starts a chain of its own."
          }
        }
      }
    },
    "overTime.keyLoss.is": {
      "comment": "What key loss is.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Losing the key is the other ending: a wipe, a restore to a new handset, or deleting the app. The key cannot be backed up or carried across, so the next run generates a new one."
          }
        }
      }
    },
    "overTime.reading.header": {
      "comment": "Section title: the unit everything else counts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What a reading is"
          }
        }
      }
    },
    "overTime.reading.is": {
      "comment": "What a reading is.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One reading is one pass over the sensors, signed and added to the chain. It takes about a second and a half, and it is the unit every count on these screens is made of."
          }
        }
      }
    },
    "overTime.reading.noSchedule": {
      "comment": "That the SDK sets no cadence.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The SDK has no schedule of its own and never wakes the phone. How often to read is the app's decision, and the numbers below simply reflect whatever it decided."
          }
        }
      }
    },
    "overTime.reading.when": {
      "comment": "When readings happen in this app.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app takes one whenever the Sensors tab is open, a few seconds apart, so a chain builds quickly here. A real app would take one when it is used, or once in the background, not continuously."
          }
        }
      }
    },
    "overTime.reset.header": {
      "comment": "Section title: break versus key loss.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two ways it can end"
          }
        }
      }
    },
    "overTime.reset.note": {
      "comment": "Footer under the two endings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Neither is a judgement about a person. Both are facts about a device, which is all continuity has ever claimed to be about."
          }
        }
      }
    },
    "overTime.row": {
      "comment": "Row on the continuity screen that opens the over-time explanation.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How this behaves over time"
          }
        }
      }
    },
    "overTime.timeline.header": {
      "comment": "Section title: the timeline of estimates.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What it is worth, as time passes"
          }
        }
      }
    },
    "overTime.timeline.note": {
      "comment": "Footer under the timeline.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Computed with this phone's current reading quality held fixed, so only time and the count move. Days count on a slow curve with no cliff — half weight at 45 days — and readings saturate, so the first few matter far more than the hundredth."
          }
        }
      }
    },
    "overTime.title": {
      "comment": "Title of the screen showing how continuity behaves as days and readings accumulate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over time"
          }
        }
      }
    },
