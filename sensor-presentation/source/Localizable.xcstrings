    "docs.motion.algorithm.0": {
      "comment": "On the Motion page, under how the answer is worked out: one step of it, in plain words.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Movement, rotation and gravity each arrive as three numbers, one per axis."
