            "value": "Carrier SIM match"
          }
        }
      }
    },
    "threeProofs.check.attestation": {
      "comment": "three proofs",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's own check of the app reports its state, and a challenge still outstanding is not a completed attestation. The two are kept apart on the continuity screen for that reason."
          }
        }
      }
    },
    "threeProofs.check.completeness": {
      "comment": "three proofs",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether the history you were handed is the whole history used to need a commitment published somewhere else. It no longer does: every reading carries the counter Apple keeps for this app's key, which the app cannot set or skip, so readings removed from a run leave a gap in the count that the run itself shows."
          }
        }
      }
    },
    "threeProofs.check.coverage": {
      "comment": "three proofs",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app signs its sensor readings. Document capture and visits live in the Pulse app, and the position used for the Air check is not yet written into the evidence here. Shared mechanisms make the rest possible; what is actually signed is what can be claimed."
          }
        }
      }
    },
    "threeProofs.check.header": {
      "comment": "Section title: how to check the claims independently.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What can be verified"
          }
        }
      }
    },
    "threeProofs.check.how": {
      "comment": "How to check the claims.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A signature establishes that the signed content was produced with the matching private key and has not changed since. A linked chain establishes the relationships and the ordering recorded inside the history you were given."
          }
        }
      }
    },
    "threeProofs.check.tamper": {
      "comment": "How to prove the check is not decoration.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is a button beside the export that alters a reading after it was signed. Use it, export again, and watch the check refuse that reading and name it. A check that never fails proves nothing."
          }
        }
      }
    },
    "threeProofs.check.time": {
      "comment": "three proofs",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Times here are the phone's own. Nothing on this screen establishes trusted wall-clock time, which needs a time source outside the device — so treat the order as proven and the clock as reported."
          }
        }
      }
    },
    "threeProofs.check.where": {
      "comment": "The verifier's path. Do not translate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "tools/verify-evidence.py"
          }
        }
      }
    },
    "threeProofs.device.breaks": {
      "comment": "What breaks the device proof.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A wipe, a reinstall, a restore to a new handset, or deleting the app all destroy the key, because it is marked to this device and never included in a backup. The next run makes a new key, and a new key cannot claim the old one's history."
          }
        }
      }
    },
    "threeProofs.device.header": {
      "comment": "Section title: the device proof.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Which phone, and its connection to your number"
          }
        }
      }
    },
    "threeProofs.device.how": {
      "comment": "How the device proof works.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The phone generates a private signing key inside its Secure Enclave and the private key stays there. Signed evidence is checked with the matching public key, and each record commits to the history before it, so a verifier can check both the signatures and the order."
          }
        }
      }
    },
    "threeProofs.device.notProves": {
      "comment": "What the device proof does not prove.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device key identifies the signer. Receiving an SMS code does not prove which SIM or handset received it, or who was holding the phone."
          }
        }
      }
    },
    "threeProofs.device.proves": {
      "comment": "What the device proof proves.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A persistent cryptographic identity for the device's evidence. A completed SMS code check records access to the number at that time. Available carrier and line checks provide separate context."
          }
        }
      }
    },
    "threeProofs.device.where": {
      "comment": "Where the device proof lives in the SDK. A file path and two function names; do not translate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KenshikiIdentity/EvidenceIntegrity.swift — signed(_:), verify(_:)"
          }
        }
      }
    },
    "threeProofs.footer": {
      "comment": "Footer at the end of the three proofs.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept apart, each proof is honest about what it can carry. Signed into one chain by one key, together they say who, where, on which phone, and in what order — which is more than any of them claims alone, and exactly as much as the three of them can back."
          }
        }
      }
    },
    "threeProofs.person.header": {
      "comment": "Section title: the person proof.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Who the person is, and recurring authentication"
          }
        }
      }
    },
    "threeProofs.person.how": {
      "comment": "How the person proof works.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The passport's printed page and its NFC chip, with the issuer signature, the certificate's path to a government trust root and the hashes of the signed data groups reported separately from mere chip access. A driving licence checked field by field against the issuing jurisdiction's records. A live face compared with the document portrait, on the phone, with presentation-attack detection."
          }
        }
      }
    },
    "threeProofs.person.notProves": {
      "comment": "What the person proof does not prove.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A matched field, an unmatched field and a field the issuer did not report keep their different meanings. Agreement elsewhere never turns an unmatched document into a matched one."
          }
        }
      }
    },
    "threeProofs.person.proves": {
      "comment": "What the person proof proves.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A named human being, holding a genuine document, present at that moment. Face ID at every app open adds recurring authentication afterwards: the document-to-face check establishes who the person is, and Face ID re-authenticates them against the phone's enrolled biometric each time."
          }
        }
      }
    },
    "threeProofs.person.where": {
      "comment": "Where the person proof lives in the SDK. Module names; do not translate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KenshikiCapture · CaptureSelfie · IdentityEvidenceApple (not shown in this app yet)"
          }
        }
      }
    },
    "threeProofs.presence.absence": {
      "comment": "How absence is handled in the presence proof.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Missing permission, absent hardware and an unreported result stay visible as limits on the evidence. A result such as \"not reported\" remains exactly that, and is never converted into a confirmed absence of change."
          }
        }
      }
    },
    "threeProofs.presence.header": {
      "comment": "Section title: the presence proof.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Where it was, how it moved, what surrounded it"
          }
        }
      }
    },
    "threeProofs.presence.how": {
      "comment": "How the presence proof works.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Core Location supplies fixes and their accuracy; visits supply arrival, departure and duration. The surrounding radio environment — Bluetooth, Wi-Fi, cellular and connection context — recurs and ties to a place. The barometer's reading is checked against the pressure expected at that elevation, and the magnetometer's against the field NOAA's model predicts there."
          }
        }
      }
    },
    "threeProofs.presence.notProves": {
      "comment": "What the presence proof does not prove.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The constellation is assessed as a combination, not as independent location measurements: its sources have different precision and different dependencies. A place is not a person until the third proof is signed alongside it."
          }
        }
      }
    },
    "threeProofs.presence.proves": {
      "comment": "What the presence proof proves.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeated visits, nights and time spent somewhere build a pattern across time. A single fix and a recurring pattern carry different weight, and the evidence records when each observation happened and how accurately it placed the phone."
          }
        }
      }
    },
    "threeProofs.presence.where": {
      "comment": "Where the presence proof lives in the SDK. File paths; do not translate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LocationCapture · KenshikiSensors/DevicePhysicsCollector.swift · IdentityAirCheck"
          }
        }
      }
    },
    "threeProofs.row": {
      "comment": "Row on the Fusion tab that opens the full explanation.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What each proof carries, and how they join"
          }
        }
      }
    },
    "threeProofs.thisPhone.chain": {
      "comment": "Row label: where this reading sits in the chain.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This reading's place"
          }
        }
      }
    },
    "threeProofs.thisPhone.held": {
      "comment": "Row label: where this phone's key lives.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Held in"
          }
        }
      }
    },
    "threeProofs.thisPhone.key": {
      "comment": "Row label: the short form of this phone's public key hash.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone's key"
          }
        }
      }
    },
    "threeProofs.title": {
      "comment": "Title of the screen explaining what proves what.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three proofs"
          }
        }
      }
    },
    "threeProofs.together.claim": {
      "comment": "The claim the three proofs together support.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A continuing, inspectable relationship between a verified person, their authenticated use of a phone, and the evidence that phone accumulates over time. The claim rests on the composition and on the history, not on any one proof."
          }
        }
      }
    },
    "threeProofs.together.header": {
      "comment": "Section title: how the proofs compose.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the three make together"
          }
        }
      }
    },
    "threeProofs.together.how": {
      "comment": "How the proofs are bound together.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One key signs it, and each record commits to the history before it, so the order is fixed and nothing can be inserted or re-dated afterwards."
          }
        }
      }
    },
    "threeProofs.together.limit": {
      "comment": "The one limit of the composition.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuous assurance means re-evaluating that relationship as new evidence arrives, and keeping the distinction between a directly verified event and continuity inferred from the record around it. The percentage is that component's estimate — not a probability that a named person is present, and not a NIST assurance level."
          }
        }
      }
    },
    "threeProofs.together.proves": {
      "comment": "What the composition proves.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The document and live face establish a named identity relationship. Carrier verification contributes phone verification. The device key identifies what signed the evidence. Face ID supplies recurring authentication. Visits, motion, overnight observations, the radio constellation, pressure and magnetism contribute continuing context."
          }
        }
      }
    },
    "threeProofs.together.today": {
      "comment": "What this app actually signs today, as opposed to what the SDK supports.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In this app, only the first two are wired: the sensors are signed, the position is read for the Air check but not written into the evidence, and visits and document capture live in the Pulse app waiting to be brought across. The mechanism is the same for all of them, which is the point of showing it on the cheap ones first."
          }
        }
      }
    },
    "unit.degrees": {
      "comment": "A direction in degrees from north, e.g. '270°'. %@ is the formatted number.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@°"
          }
        }
      }
    },
    "unit.g": {
      "comment": "Acceleration in g (multiples of Earth's gravity), e.g. '0.012 g'. %@ is the formatted number.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ g"
          }
        }
      }
    },
    "unit.hectopascals": {
      "comment": "Air pressure in hectopascals, e.g. '1013.25 hPa'. %@ is the formatted number.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hPa"
          }
        }
      }
    },
    "unit.metres": {
      "comment": "A height in metres, e.g. '12.3 m'. %@ is the formatted number.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ m"
          }
        }
      }
    },
    "unit.metresPerSecond": {
      "comment": "A speed in metres per second, e.g. '1.2 m/s'. %@ is the formatted number.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ m/s"
          }
        }
      }
    },
    "unit.microtesla": {
      "comment": "Magnetic field strength in microtesla, e.g. '42.100 µT'. %@ is the formatted number.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ µT"
          }
        }
      }
    },
    "unit.plusMinusMetres": {
      "comment": "How far off a position may be, in metres, e.g. '± 5.0 m'. %@ is the formatted number.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "± %@ m"
          }
        }
      }
    },
    "unit.radiansPerSecond": {
      "comment": "Rotation speed in radians per second, e.g. '0.003 rad/s'. %@ is the formatted number.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ rad/s"
          }
        }
      }
    },
    "unit.seconds": {
      "comment": "A reading time in seconds, e.g. '1.5 s'. %@ is the formatted number.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
