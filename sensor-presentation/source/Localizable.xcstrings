{
  "sourceLanguage": "en",
  "strings": {
    "airCheck.absence.cancelled": {
      "comment": "No answer: the run was cancelled, e.g. the app left the screen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The check stopped before it finished."
          }
        }
      }
    },
    "airCheck.absence.invalidLocation": {
      "comment": "No answer: the fix failed the package's admission rules.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The position was too rough or too odd to compare against."
          }
        }
      }
    },
    "airCheck.absence.invalidPressure": {
      "comment": "No answer: the barometer value was not usable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pressure reading was outside any sensible range."
          }
        }
      }
    },
    "airCheck.absence.invalidWeather": {
      "comment": "No answer: the weather value was not usable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The weather reading was outside any sensible range."
          }
        }
      }
    },
    "airCheck.absence.pressureOutsideWindow": {
      "comment": "No answer: the two readings did not belong to the same moment.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pressure and the position were taken too far apart in time."
          }
        }
      }
    },
    "airCheck.absence.pressureUnavailable": {
      "comment": "No answer: no pressure reading arrived.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No barometer reading. The phone may have no barometer, or Motion & Fitness is off."
          }
        }
      }
    },
    "airCheck.absence.simulatedLocation": {
      "comment": "No answer: the location came from a simulator or a location spoof.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The position is simulated, so there is nothing real to compare."
          }
        }
      }
    },
    "airCheck.absence.timedOut": {
      "comment": "No answer: it took too long.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The check ran out of time."
          }
        }
      }
    },
    "airCheck.absence.weatherOutsideWindow": {
      "comment": "No answer: the weather was too old for the position.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The weather and the position were taken too far apart in time."
          }
        }
      }
    },
    "airCheck.absence.weatherUnavailable": {
      "comment": "No answer: the US National Weather Service gave nothing usable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No weather for this area. No nearby US weather station reported a recent sea-level pressure, or the service didn't answer."
          }
        }
      }
    },
    "airCheck.button.run": {
      "comment": "Button that starts one air check.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run air check"
          }
        }
      }
    },
    "airCheck.button.running": {
      "comment": "The button's title while a check is running.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking…"
          }
        }
      }
    },
    "airCheck.confidence.high": {
      "comment": "Confidence: the position was precise enough.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High"
          }
        }
      }
    },
    "airCheck.confidence.medium": {
      "comment": "Confidence: the position was wider, so the answer rests on less.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Medium"
          }
        }
      }
    },
    "airCheck.hat.caption": {
      "comment": "Caption under the air-check drawing, explaining what the ring and triangle mean.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ring is the allowance and the triangle is the disagreement. Inside the ring the three witnesses agree; touching it means the disagreement is exactly the allowance."
          }
        }
      }
    },
    "airCheck.header": {
      "comment": "Section title on the Air check tab.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Air check"
          }
        }
      }
    },
    "airCheck.intro": {
      "comment": "Footer under the Air check button explaining what a run does.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads this phone's air pressure and compares it with the nearest US weather station's reading, worked out for the height of your position. Two sensors and a weather service in one answer."
          }
        }
      }
    },
    "airCheck.measured.header": {
      "comment": "Section title above the measured and expected pressures.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The numbers"
          }
        }
      }
    },
    "airCheck.motion.needed": {
      "comment": "Line shown when the permission the barometer needs is off.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs Motion & Fitness for the barometer. Turn it on from the Settings tab."
          }
        }
      }
    },
    "airCheck.navigationTitle": {
      "comment": "Large title at the top of the Air check tab.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Air check"
          }
        }
      }
    },
    "airCheck.note.allowed": {
      "comment": "Footer explaining where the allowance comes from.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The allowance is worked out from how precise the height was, how uncertain the air temperature is, and the weather's own pressure uncertainty."
          }
        }
      }
    },
    "airCheck.place.header": {
      "comment": "Section title above the position the check used.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where and when"
          }
        }
      }
    },
    "airCheck.result.doesNotMatch": {
      "comment": "The measured pressure did not agree with the area's weather.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doesn't match the area"
          }
        }
      }
    },
    "airCheck.result.header": {
      "comment": "Section title above the result of a check.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer"
          }
        }
      }
    },
    "airCheck.result.matches": {
      "comment": "The measured pressure agreed with the area's weather.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matches the area"
          }
        }
      }
    },
    "airCheck.result.noFix": {
      "comment": "Shown when iOS gave no position at all.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No position, so there was nothing to check against."
          }
        }
      }
    },
    "airCheck.result.notAVerdict": {
      "comment": "Footer under the answer, making clear it is evidence and not a judgement.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A mismatch is not proof of anything. Weather moves, and a rough position moves the expected pressure with it."
          }
        }
      }
    },
    "airCheck.row.allowed": {
      "comment": "Row label: how far apart they may be and still match.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowed"
          }
        }
      }
    },
    "airCheck.row.altitude": {
      "comment": "Row label: the altitude of the position used.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Height"
          }
        }
      }
    },
    "airCheck.row.calibration": {
      "comment": "Row label: which version of the comparison's constants was used.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibration"
          }
        }
      }
    },
    "airCheck.row.confidence": {
      "comment": "Row label: how good the position was that the answer rests on.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confidence"
          }
        }
      }
    },
    "airCheck.row.difference": {
      "comment": "Row label: how far apart the two pressures are.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Difference"
          }
        }
      }
    },
    "airCheck.row.expected": {
      "comment": "Row label: the pressure the area's weather implies at your height.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expected here"
          }
        }
      }
    },
    "airCheck.row.fetchedAt": {
      "comment": "Row label: when the weather was fetched.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fetched"
          }
        }
      }
    },
    "airCheck.row.horizontalAccuracy": {
      "comment": "Row label: the horizontal accuracy of the position.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Position could be off by"
          }
        }
      }
    },
    "airCheck.row.humidity": {
      "comment": "Row label: the area's relative humidity, in percent.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Humidity"
          }
        }
      }
    },
    "airCheck.row.measured": {
      "comment": "Row label: the pressure this phone's barometer read.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measured here"
          }
        }
      }
    },
    "airCheck.row.pressureReadAt": {
      "comment": "Row label: when the barometer reading was taken.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressure read"
          }
        }
      }
    },
    "airCheck.row.quality": {
      "comment": "Row label: the quality flag the weather service put on its pressure reading.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quality check"
          }
        }
      }
    },
    "airCheck.row.ranAt": {
      "comment": "Row label: when the last check finished.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last run"
          }
        }
      }
    },
    "airCheck.row.reportedAt": {
      "comment": "Row label: when the weather service says its reading was taken.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weather measured"
          }
        }
      }
    },
    "airCheck.row.scaleHeight": {
      "comment": "Row label: the scale height, the height over which pressure falls by a set fraction.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Air column"
          }
        }
      }
    },
    "airCheck.row.seaLevel": {
      "comment": "Row label: the area's pressure reduced to sea level.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At sea level"
          }
        }
      }
    },
    "airCheck.row.source": {
      "comment": "Row label: which weather service the reading came from.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source"
          }
        }
      }
    },
    "airCheck.row.station": {
      "comment": "Row label: the weather station the reading came from.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Station"
          }
        }
      }
    },
    "airCheck.row.stationDistance": {
      "comment": "Row label: how far away that weather station is.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Station distance"
          }
        }
      }
    },
    "airCheck.row.stationHeight": {
      "comment": "Row label: the station's height above sea level, which the comparison uses.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Station height"
          }
        }
      }
    },
    "airCheck.row.temperature": {
      "comment": "Row label: the area's air temperature.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temperature"
          }
        }
      }
    },
    "airCheck.row.verticalAccuracy": {
      "comment": "Row label: the vertical accuracy of the position.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Height could be off by"
          }
        }
      }
    },
    "airCheck.source.nws": {
      "comment": "The weather source. Keep the service's own name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "US National Weather Service"
          }
        }
      }
    },
    "airCheck.tab": {
      "comment": "Tab title: comparing the phone's air pressure with the area's weather.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Air check"
          }
        }
      }
    },
    "airCheck.weather.header": {
      "comment": "Section title above what the weather service reported.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Area weather"
          }
        }
      }
    },
    "airCheck.witness.areaReport": {
      "comment": "Label on one corner of the air-check drawing: the weather station's reading.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Area report"
          }
        }
      }
    },
    "airCheck.witness.barometer": {
      "comment": "Label on one corner of the air-check drawing: this phone's own pressure reading.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Barometer"
          }
        }
      }
    },
    "airCheck.witness.position": {
      "comment": "Label on one corner of the air-check drawing: the position iOS gave.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Position"
          }
        }
      }
    },
    "airCheckMath.allowance.floorNote": {
      "comment": "Footer shown when the computed budget is smaller than the floor.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three uncertainties added in quadrature came out under the floor, so the floor is the allowance: a perfect fix is not asked for perfect agreement."
          }
        }
      }
    },
    "airCheckMath.allowance.header": {
      "comment": "Section title: the third step, how far apart the two may be.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. The allowance"
          }
        }
      }
    },
    "airCheckMath.allowance.note": {
      "comment": "Footer explaining the allowance step.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three uncertainties added in quadrature: how precisely your height is known, how little is known about the column's temperature, and the weather's own pressure uncertainty."
          }
        }
      }
    },
    "airCheckMath.answer.header": {
      "comment": "Section title: the last step, the comparison itself.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "4. The answer"
          }
        }
      }
    },
    "airCheckMath.answer.note": {
      "comment": "Footer under the comparison step.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The residual is a distance, not a judgement: the same number is a match at one allowance and a mismatch at another."
          }
        }
      }
    },
    "airCheckMath.calibration": {
      "comment": "Row label: which version of the constants this answer used.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibration"
          }
        }
      }
    },
    "airCheckMath.column.header": {
      "comment": "Section title: the first step, how fast pressure falls here.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. The air column"
          }
        }
      }
    },
    "airCheckMath.column.note": {
      "comment": "Footer explaining the air column step.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "H is the height over which pressure falls to about a third. Warmer air is less dense, so a warm column is taller and pressure falls more slowly. Half the standard lapse rate stands for the column's mean rather than its surface."
          }
        }
      }
    },
    "airCheckMath.constants.header": {
      "comment": "Section title above the fixed values the formulas use.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Constants"
          }
        }
      }
    },
    "airCheckMath.constants.note": {
      "comment": "Footer under the constants, saying where they come from.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read from the SDK, not retyped here. The floor and ceiling are read out of the comparison itself, so they cannot drift from it. These are standard atmospheric approximations, not a calibration measured against a population."
          }
        }
      }
    },
    "airCheckMath.expected.header": {
      "comment": "Section title: the second step, the pressure implied at your height.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. The expected pressure"
          }
        }
      }
    },
    "airCheckMath.expected.note": {
      "comment": "Footer explaining the expected-pressure step.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where the station's height is known, the reading is brought down to the station first and then to you, which keeps the station's own elevation visible instead of hidden inside one exponent."
          }
        }
      }
    },
    "airCheckMath.row": {
      "comment": "Row on the Air check tab that opens the working.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How this was worked out"
          }
        }
      }
    },
    "airCheckMath.title": {
      "comment": "Title of the sheet showing the formulas behind one air check, with this run's numbers.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The working"
          }
        }
      }
    },
    "airCheckMath.unit.kelvin": {
      "comment": "Unit: kelvin.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "K"
          }
        }
      }
    },
    "airCheckMath.unit.kelvinPerMetre": {
      "comment": "Unit: kelvin per metre.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "K/m"
          }
        }
      }
    },
    "airCheckMath.unit.kilopascals": {
      "comment": "Unit: kilopascals, the unit the formulas are written in.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "kPa"
          }
        }
      }
    },
    "airCheckMath.unit.metresPerKelvin": {
      "comment": "Unit: metres per kelvin.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "m/K"
          }
        }
      }
    },
    "audioRoute.footer": {
      "comment": "Footer under the Audio route section.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect headphones and each count goes up by one. The counts are kept after the app closes, until you erase them."
          }
        }
      }
    },
    "audioRoute.header": {
      "comment": "Section title on the Sensors tab: where sound plays.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio route"
          }
        }
      }
    },
    "audioRoute.row.external": {
      "comment": "Row label: whether sound plays through something outside the phone. Value is Yes or No.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "External"
          }
        }
      }
    },
