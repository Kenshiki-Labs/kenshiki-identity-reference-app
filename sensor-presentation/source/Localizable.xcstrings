      "comment": "Footer under the continuity verdict.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compared with the pass before this one. A changed network or a sensor you turned off never breaks continuity; only the phone itself changing does."
          }
        }
      }
    },
    "continuity.break.deviceChange": {
      "comment": "Break reason: the device itself changed.",
