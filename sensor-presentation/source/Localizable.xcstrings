    "docs.location.algorithm.0": {
      "comment": "On the Location page, under how the answer is worked out: one step of it, in plain words.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS often delivers several positions at once, and the newest is not the best: a network estimate can arrive after a satellite fix."
          }
        }
      }
    },
    "docs.location.algorithm.1": {
      "comment": "On the Location page, under how the answer is worked out: one step of it, in plain words.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each position is admitted only if its coordinate and accuracy are usable at all."
          }
        }
      }
    },
    "docs.location.algorithm.2": {
      "comment": "On the Location page, under how the answer is worked out: one step of it, in plain words.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The one published is the best of the batch: movement first, then the smaller combined horizontal and vertical uncertainty, so a converging fix cannot be displaced by a wider one that merely arrived later."
          }
        }
      }
    },
    "docs.location.algorithm.3": {
      "comment": "On the Location page, under how the answer is worked out: one step of it, in plain words.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A position stamped in the future is refused, and a position from before this run began cannot answer for it."
          }
        }
      }
    },
