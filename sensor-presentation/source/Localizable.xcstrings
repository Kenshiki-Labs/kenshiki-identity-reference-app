      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved fingerprint is the only judgement this app keeps between launches. Erase on the Settings tab clears the SDK's own stores."
          }
        }
      }
    },
    "continuity.header": {
      "comment": "Title of the continuity screen.",
