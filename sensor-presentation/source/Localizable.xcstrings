      }
    },
    "glossary.appAttest.body": {
      "comment": "Glossary definition of App Attest.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's own statement that this is an unmodified build of this app, running on a genuine Apple device. It needs a one-time number from a server to answer fully; without one it reports that a challenge is required, which is a state and not a failure."
          }
        }
      }
    },
    "glossary.appAttest.term": {
      "comment": "Glossary term. Apple's own name; keep it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App Attest"
          }
        }
      }
    },
    "glossary.canonical.body": {
      "comment": "Glossary definition of canonical form.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One exact way of writing the data down, so that signing and checking agree byte for byte: keys in alphabetical order, no stray spaces, times written one fixed way. Without it, two programs could describe the same reading differently and a perfectly good signature would appear broken."
          }
        }
      }
    },
    "glossary.canonical.term": {
      "comment": "Glossary term.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Canonical form"
          }
        }
      }
    },
    "glossary.chainRoot.body": {
      "comment": "Glossary definition of the Merkle root.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The single value at the top of the chain, standing for every reading beneath it. Two people holding the same root agree about the entire history without comparing it reading by reading."
          }
        }
      }
    },
    "glossary.chainRoot.term": {
      "comment": "Glossary term: the Merkle root.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Root"
          }
        }
      }
    },
    "glossary.hash.body": {
      "comment": "Glossary definition of a hash.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A short fingerprint of some data, produced by a fixed recipe. The same data always gives the same fingerprint, any change gives a completely different one, and you cannot work backwards from the fingerprint to the data. Here it is SHA-256, and it is how a reading is summarised before being signed or chained."
          }
        }
      }
    },
    "glossary.hash.term": {
      "comment": "Glossary term.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hash"
          }
        }
      }
    },
    "glossary.merkle.body": {
      "comment": "Glossary definition of a Merkle chain.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A way of committing to a list so that it cannot be edited quietly. Each reading is hashed; pairs of hashes are hashed together, then pairs of those, up to one value called the root. Every new reading is added and a new root computed, and each reading records the root before it. Change, delete or insert anything and every root after it stops matching — so tampering is not merely detectable, it is visible at the exact position."
          }
        }
      }
    },
    "glossary.merkle.term": {
      "comment": "Glossary term.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkle chain"
          }
        }
      }
    },
    "glossary.row": {
      "comment": "Row that opens the glossary.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Words used here"
          }
        }
      }
    },
    "glossary.secureEnclave.body": {
      "comment": "Glossary definition of the Secure Enclave.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A separate processor inside the iPhone with its own memory, built to hold keys. A key made there can be used — asked to sign something — but never read out, not by this app, not by iOS, not by anyone with the phone unlocked in their hand. That is what makes a signature evidence of a particular phone rather than of some software that knows a secret."
          }
        }
      }
    },
    "glossary.secureEnclave.term": {
      "comment": "Glossary term. Apple's own name; keep it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure Enclave"
          }
        }
      }
    },
    "glossary.signature.body": {
      "comment": "Glossary definition of a signature.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proof that a particular key approved a particular piece of data. The private half signs; the public half, which anyone may hold, checks. Unlike a password, checking it reveals nothing that would let you forge the next one. Here it is ECDSA on the P-256 curve, over a SHA-256 hash."
          }
        }
      }
    },
    "glossary.signature.term": {
      "comment": "Glossary term.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signature"
          }
        }
      }
    },
    "glossary.title": {
      "comment": "Title of the glossary screen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Words used here"
          }
        }
      }
    },
    "location.button.getOneFix": {
      "comment": "Button: ask iOS for the phone's position once. Other notes and the location permission prompt name this button, so keep them in step.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get one fix"
          }
        }
      }
    },
    "location.button.gettingFix": {
      "comment": "The Get one fix button's title while iOS looks for the position.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Getting a fix…"
          }
        }
      }
    },
    "location.footer": {
      "comment": "Footer under the Location section.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing here is saved. Only the map area is sent to Apple, to draw the map."
          }
        }
      }
    },
    "location.header": {
      "comment": "Section title on the Sensors tab.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location"
          }
        }
      }
    },
    "location.map.button.clear": {
      "comment": "Button beside Dots on the map: removes every dot.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear"
          }
        }
      }
    },
    "location.map.empty.locationOff": {
      "comment": "Notice over the empty map when location is not allowed. 'Location while using' is a switch on this app's Settings tab; 'Get one fix' is the button's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location is off. Turn on Location while using on the Settings tab, then press Get one fix."
          }
        }
      }
    },
    "location.map.empty.noFixes": {
      "comment": "Notice over the empty map when location is allowed. 'Get one fix' is the button's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No positions yet. Press Get one fix."
          }
        }
      }
    },
    "location.map.note": {
      "comment": "Caption under the map. The colour words must match colors.preciseFix and colors.approximateFix in SensorHostConfig.jsonc. 'Get one fix' is the button's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each press of Get one fix adds a dot, inside a circle showing how far off it might be. Blue is precise, orange is approximate. The ringed dot is the app's best guess of where the phone is now."
          }
        }
      }
    },
    "location.map.row.fixesOnMap": {
      "comment": "Row label under the map: how many positions are drawn, out of the most kept.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dots on the map"
          }
        }
      }
    },
    "location.map.value.fixesOnMapCount": {
      "comment": "Value of the Dots on the map row, e.g. '3 of 20'. %1$@ is dots drawn, %2$@ the most kept.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ of %2$@"
          }
        }
      }
    },
    "location.note.accuracy": {
      "comment": "Caption under the accuracy rows.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How far off the position and the height might be. Smaller is better."
          }
        }
      }
    },
    "location.note.altitude": {
      "comment": "Caption under the height above sea level row.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shown only when iOS gives one."
          }
        }
      }
    },
    "location.note.contract": {
      "comment": "Caption under the Basic checks rows.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The position must have a real time, be on the globe and say how accurate it is. When iOS sends several, the best one is shown."
          }
        }
      }
    },
    "location.note.getOneFix": {
      "comment": "Caption under the Get one fix button.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asks iOS for the phone's position once. iOS decides how long that takes."
          }
        }
      }
    },
    "location.note.movement": {
      "comment": "Caption under the speed and direction rows.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How fast and which way the phone was moving. A phone lying still usually has neither."
          }
        }
      }
    },
    "location.note.noFix": {
      "comment": "Caption under 'Result: No position'.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location may be off, or iOS couldn't find the phone."
          }
        }
      }
    },
    "location.note.position": {
      "comment": "Caption under the latitude and longitude rows.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where the phone is, exactly as iOS reported it."
          }
        }
      }
    },
    "location.note.source": {
      "comment": "Caption under the source rows. 'A dash' refers to the common.none mark; keep them in step.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A dash means iOS didn't say."
          }
        }
      }
    },
    "location.note.time": {
      "comment": "Caption under the Measured at and Age rows.",
      "extractionState": "manual",
      "localizations": {
