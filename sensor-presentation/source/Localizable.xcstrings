      "comment": "Row label: whether the signing key lives in the Secure Enclave or in software.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Key held in"
          }
        }
      }
    },
    "continuity.row.lanesEligible": {
      "comment": "Row label: how many sensors were able to read at all, out of all the ones continuity knows.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensors that could read"
          }
        }
      }
    },
    "continuity.row.lanesObserved": {
      "comment": "Row label: how many of those actually produced a reading.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensors that did read"
          }
        }
      }
    },
    "continuity.row.lowerBound": {
      "comment": "Row label: the conservative lower bound of the estimate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least"
          }
        }
      }
    },
    "continuity.row.networkFamiliarity": {
      "comment": "Row label: how familiar this network is.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seen before"
          }
        }
      }
    },
    "continuity.row.networkStability": {
      "comment": "Row label: whether the Wi-Fi is the same as last pass.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same network"
          }
        }
      }
    },
    "continuity.row.passes": {
      "comment": "Row label: how many collection passes this install has recorded.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Readings so far"
          }
        }
      }
    },
    "continuity.row.payloadHash": {
      "comment": "Row label: the hash of the signed reading.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This reading's hash"
          }
        }
      }
    },
    "continuity.row.signature": {
      "comment": "Row label: whether this reading's signature checks out.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signature"
          }
        }
      }
    },
    "continuity.row.sinceBreak": {
      "comment": "Row label: when the earned history was last thrown away by a break.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History restarted"
          }
        }
      }
    },
    "continuity.row.working": {
      "comment": "Row that opens the continuity working.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How this was worked out"
          }
        }
      }
    },
    "continuity.score.header": {
      "comment": "Section title above the continuity score and its uncertainty.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The estimate"
          }
        }
      }
    },
    "continuity.score.note": {
      "comment": "Footer under the score.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An estimate with its uncertainty, not a verdict. It needs both a history worth something and a live reading worth something: either one near zero pulls it down. A break throws the history away, and it has to be earned again."
          }
        }
      }
    },
    "continuity.signature.invalid": {
      "comment": "The signature failed verification.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Does not check out"
          }
        }
      }
    },
    "continuity.signature.valid": {
      "comment": "The signature verifies against the public key in the receipt.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks out"
          }
        }
      }
    },
    "continuity.state.contradictory": {
      "comment": "Lane state: its reading disagreed with itself.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contradicts itself"
          }
        }
      }
    },
    "continuity.state.empty": {
      "comment": "Lane state: the sensor could have read but produced nothing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No reading"
          }
        }
      }
    },
    "continuity.state.observed": {
      "comment": "Lane state: this sensor produced a usable reading this time.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gave a reading"
          }
        }
      }
    },
    "continuity.state.stale": {
      "comment": "Lane state: its reading was older than the freshness window.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too old"
          }
        }
      }
    },
    "continuity.state.unavailable": {
      "comment": "Lane state: the sensor or permission is not there, which is context and not evidence.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not available"
          }
        }
      }
    },
    "continuity.unsigned": {
      "comment": "Shown when signing is off or a receipt is missing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This reading carries no receipt, so nothing anchors it."
          }
        }
      }
    },
    "continuity.waiting": {
      "comment": "Shown before the first collection pass has finished.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for a reading from the Sensors tab."
          }
        }
      }
    },
    "continuityMath.anchor.chain": {
      "comment": "Plain-words line under the chain formula.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each reading is hashed and committed together with the root before it. Alter a past reading and every root after it stops matching; delete or insert one and the count and position no longer line up."
          }
        }
      }
    },
    "continuityMath.anchor.header": {
      "comment": "Section title: the three mechanisms behind sameness.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What proves it is the same phone"
          }
        }
      }
    },
    "continuityMath.anchor.key": {
      "comment": "Plain-words line under the key formula.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The private key is generated inside the phone and cannot be read out or copied, not even by this app. Only the public half travels. A new phone, a wipe or a reinstall means a new key, and a new key cannot claim the old one's history."
          }
        }
      }
    },
    "continuityMath.anchor.note": {
      "comment": "Footer under the three mechanisms.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three mechanisms, three questions. The key answers which phone, the chain answers whether the history was edited, and the sensors answer whether that phone was really present. Only the third is scored below; the first two are either true or the evidence is worthless."
          }
        }
      }
    },
    "continuityMath.anchor.sensors": {
      "comment": "Plain-words line under the sensor formula.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A key can be exercised by anything holding the phone. The sensors are what say a phone was actually there, in real air, on a known network — cheap to read, expensive to fake for months."
          }
        }
      }
    },
    "continuityMath.break.header": {
      "comment": "Section title: the rule that decides a break.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. The break rule"
          }
        }
      }
    },
    "continuityMath.break.note": {
      "comment": "Footer under the break rule.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the phone's own identity and its SIM can break continuity. The network is compared, but a change never breaks it: people move."
          }
        }
      }
    },
    "continuityMath.broke": {
      "comment": "Shown before the reason when continuity broke.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Broke"
          }
        }
      }
    },
    "continuityMath.claim.gloss": {
      "comment": "Line under the claim, in plain words.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A chain of readings from one phone. The break test says whether the chain snapped; the estimate says what the chain is worth."
          }
        }
      }
    },
    "continuityMath.claim.header": {
      "comment": "Section title: the statement the whole computation is about.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What continuity claims"
          }
        }
      }
    },
    "continuityMath.claim.note": {
      "comment": "Footer under the claim.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is not a claim about a person. A phone taken from you carries its continuity with it, which is why this is one lane of evidence beside a document and a face, never the whole answer."
          }
        }
      }
    },
    "continuityMath.constants.header": {
      "comment": "Section title above the model's tunables.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Constants"
          }
        }
      }
    },
    "continuityMath.constants.note": {
      "comment": "Footer under the constants.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read from the SDK, not retyped here. They are chosen shapes rather than measured ones: the half-maturity point says when a history counts for half, not what a person is."
          }
        }
      }
    },
    "continuityMath.doesNotVerify": {
      "comment": "The signature fails.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "does not verify"
          }
        }
      }
    },
    "continuityMath.estimate.header": {
      "comment": "Section title: the final estimate and its bound.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "4. The estimate"
          }
        }
      }
    },
    "continuityMath.estimate.note": {
      "comment": "Footer under the estimate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History and the live moment are combined the same soft way: both must be worth something. The lower bound is the tenth percentile of a Beta posterior with a weak sceptical prior, so few readings mean a wide gap and a low tightness."
          }
        }
      }
    },
    "continuityMath.fractions.header": {
      "comment": "Section title: the two fractions.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. What read, and what could have"
          }
        }
      }
    },
    "continuityMath.fractions.note": {
      "comment": "Footer under the fractions.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breadth discounts how much this pass can claim. Coverage measures only the lanes that were able to speak, so an unavailable lane never counts as a silence held against you."
          }
        }
      }
    },
    "continuityMath.inEnclave": {
      "comment": "Where the key lives.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "in the Secure Enclave"
          }
        }
      }
    },
    "continuityMath.inSoftware": {
      "comment": "Where the key lives when there is no enclave.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "in software"
          }
        }
      }
    },
    "continuityMath.live.header": {
      "comment": "Section title: the live-evidence term.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. How good this moment is"
          }
        }
      }
    },
    "continuityMath.live.note": {
      "comment": "Footer under the live-evidence term.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A geometric mean, so one weak part drags the result down and cannot be made up for by the others. The floor stops a single zero from wiping it out. Coherence is the only place a network change counts, and it is a nudge, not a verdict."
          }
        }
      }
    },
    "continuityMath.maturity.header": {
      "comment": "Section title: the maturity term.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. How much history is behind it"
          }
        }
      }
    },
    "continuityMath.maturity.note": {
      "comment": "Footer under the maturity term.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Days count on a slow curve rather than a cliff, and readings saturate. Readings are weighted by breadth, so a hundred readings from one sensor never look like a hundred from twelve."
          }
        }
      }
    },
    "continuityMath.noBreak": {
      "comment": "Shown when nothing broke.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No term was true, so continuity held."
          }
        }
      }
    },
    "continuityMath.states.header": {
      "comment": "Section title: how many sensors were in each state.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensors, counted by what they gave"
          }
        }
      }
    },
    "continuityMath.states.note": {
      "comment": "Footer under the state counts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These add up to the numerators above, so the fractions can be checked by counting."
          }
        }
      }
    },
    "continuityMath.title": {
      "comment": "Title of the sheet showing how a continuity answer was reached.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The working"
          }
        }
      }
    },
    "continuityMath.unit.days": {
      "comment": "Unit: days.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "days"
          }
        }
      }
    },
    "continuityMath.unit.readings": {
      "comment": "Unit: readings, used for the model's prior strength.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "readings"
          }
        }
      }
    },
    "continuityMath.verifies": {
      "comment": "The signature checks out.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "verifies"
          }
        }
      }
    },
    "deviceSurface.header": {
      "comment": "Section title on the Sensors tab: this phone and its system.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device"
          }
        }
      }
    },
    "deviceSurface.row.bundleIdentifier": {
      "comment": "Row label: this app's ID, e.g. org.example.sensorhost. The value is shown as-is.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App ID"
          }
        }
      }
    },
    "deviceSurface.row.idiom": {
      "comment": "Row label: iPhone, iPad and so on.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device type"
          }
        }
      }
    },
    "deviceSurface.row.majorVersion": {
      "comment": "Row label: the operating system's main version number.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version"
          }
        }
      }
    },
    "deviceSurface.row.platform": {
      "comment": "Row label: the platform, e.g. iOS.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Platform"
          }
        }
      }
    },
    "deviceSurface.row.simulator": {
      "comment": "Row label: whether the app runs in the Simulator on a Mac. Value is Yes or No.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulator"
          }
        }
      }
    },
    "deviceSurface.row.system": {
      "comment": "Row label: the operating system's name, e.g. iOS.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System"
          }
        }
      }
    },
