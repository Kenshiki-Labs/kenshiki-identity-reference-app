    "magnetometer.footer": {
      "comment": "Footer under the Magnetic field section. µT is microtesla.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Earth's field is about 25 to 65 µT. Hold the phone near a speaker magnet and the number jumps."
          }
        }
      }
    },
    "magnetometer.header": {
      "comment": "Section title on the Sensors tab: the magnetic field sensor.",
      "extractionState": "manual",
